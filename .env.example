# ==============================================================================
# WA2SHELL — Environment Configuration
# ==============================================================================

# 1. BOT IDENTITY & ACCESS CONTROL
# Primary administrator phone number in international format (no leading '+', spaces, or hyphens)
# Example: 14155552671 or 6281234567890
OWNER_NUMBER="628xxxxxxxxxx"

# Display name of the bot used in greetings and headers
BOT_NAME="wa2shell"

# Prefix character for trigger commands (default: .)
BOT_PREFIX="."

# 2. WHATSAPP CONNECTION MODE
# Set to 'true' to log in using an 8-digit Pairing Code (recommended for headless servers)
# Set to 'false' to display an interactive ASCII QR code in the terminal
USE_PAIRING_CODE=true

# Bot WhatsApp phone number used to request the pairing code (international format, no '+')
BOT_PHONE_NUMBER="628yyyyyyyyyy"

# 3. ANTIGRAVITY (AGY) CLI ENGINE
# Path to the Antigravity CLI binary executable.
# Automatically resolves to 'agy' in system PATH or '/root/.local/bin/agy' if left as 'agy'
AGY_PATH="agy"

# Default LLM model identifier used when launching the agent
# Popular choices: gemini-3.8-flash-low, gemini-3.8-flash-high, claude-sonnet-5-5-high
AGY_DEFAULT_MODEL="gemini-3.8-flash-low"

# Default working directory for the agent execution environment
AGY_WORKDIR="/root"

# Idle conversation session time-to-live (TTL) in milliseconds (default: 5 minutes = 300000ms)
SESSION_TTL_MS=300000

# 4. SECURITY & PERMISSIONS
# Restrict direct bash execution and sensitive agent features strictly to OWNER_NUMBER
# Strongly recommended to leave this enabled in production environments
OWNER_ONLY=true

# 5. AUTOMATED REPOSITORY UPDATER & SCHEDULE
# Enable periodic background checks on GitHub for newer commits (true/false)
AUTO_UPDATE=false

# Auto-update polling interval in minutes (default: 60)
UPDATE_INTERVAL_MIN=60

# Git target branch to track (default: main)
UPDATE_BRANCH="main"

# Automatically apply git pull and hot-reload when new commits are found (true/false)
# If false, sends a WhatsApp alert to the owner without modifying the filesystem
AUTO_UPDATE_APPLY=false

# 6. SYSTEM HEALTH WATCHDOG & SELF-HEALING
# Enable background self-healing watcher (cleans bloated tmp, clears hung tasks)
AUTO_RECOVERY=true

# Health watchdog check interval in minutes (default: 15)
HEALTH_CHECK_INTERVAL_MIN=15

# Memory usage percentage threshold to trigger warning / self-healing (default: 85%)
HEALTH_MEM_THRESHOLD=85

# Disk usage percentage threshold to trigger critical alert (default: 90%)
HEALTH_DISK_THRESHOLD=90

# Maximum allowed tmp directory size in MB before auto-cleanup (default: 300)
HEALTH_TMP_MAX_MB=300
