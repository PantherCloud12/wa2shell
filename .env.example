# ==========================================
# WA2SHELL — Configuration Environment
# ==========================================

# 1. BOT IDENTITY & ACCESS CONTROL
# Nomor HP Owner (format internasional tanpa tanda +, contoh: 6281234567890)
OWNER_NUMBER="628xxxxxxxxxx"
# Nama Bot yang tampil di pesan / header
BOT_NAME="wa2shell"
# Prefix perintah bot (opsional, default: .)
BOT_PREFIX="."

# 2. WHATSAPP CONNECTION MODE
# Set TRUE jika ingin login menggunakan 8-digit Pairing Code (sangat cocok untuk VPS headless)
# Set FALSE jika ingin scan QR code di terminal
USE_PAIRING_CODE=true
# Nomor WhatsApp bot untuk request pairing code (tanpa tanda +)
BOT_PHONE_NUMBER="628yyyyyyyyyy"

# 3. ANTIGRAVITY (AGY) CLI ENGINE
# Path ke binary executable CLI `agy`. Default otomatis mencari di PATH atau /root/.local/bin/agy
AGY_PATH="agy"
# Model AI default untuk Antigravity (bisa diubah saat runtime via command .model)
# Pilihan populer: gemini-3.8-flash-low, gemini-3.8-flash-high, gemini-4-argon-medium, claude-sonnet-5-5-high
AGY_DEFAULT_MODEL="gemini-3.8-flash-low"
# Working directory eksekusi agent (default: path project ini atau /root)
AGY_WORKDIR="/root"
# Batas waktu idle sesi per chat dalam milidetik (default: 5 menit)
SESSION_TTL_MS=300000

# 4. SECURITY & PERMISSIONS
# Izinkan hanya Owner untuk mengeksekusi shell langsung dan perintah agent sensitif (sangat disarankan TRUE)
OWNER_ONLY=true
